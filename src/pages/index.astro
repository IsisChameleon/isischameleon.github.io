---
import SiteLayout from '@/layouts/SiteLayout.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import BlogCard from '@/components/BlogCard.astro';
import { getMergedPosts } from '@/lib/posts';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects')).filter((project) => project.data.featured).slice(0, 3);
const posts = await getMergedPosts(3);
---
<SiteLayout title="Home" description="Systems-oriented engineering work, projects, and writing.">
  <section class="section-block">
    <div class="grid gap-10 md:grid-cols-[1.2fr_0.8fr] items-center">
      <div class="space-y-6">
        <p class="text-xs uppercase tracking-[0.3em] text-base-400">AI engineering · Sydney</p>
        <h1 class="text-3xl md:text-4xl font-semibold tracking-tight text-base-950 dark:text-base-50">
          Hi, I&rsquo;m Isabelle. I explore how modern tools can actually be useful — lately, by
          building and shipping AI voice agents.
        </h1>
        <p class="text-base-600 dark:text-base-300 max-w-xl">
          I&rsquo;ve just wrapped up a founding-engineer chapter at Quarterzip (formerly Redactive): two years
          of building real-time voice agents, LLM systems and data pipelines end to end, from first discovery
          call to production support. I&rsquo;m now looking for my next role. Before startup life, I was at
          InLoop (and then NAB) shipping claiming solutions for NDIS and HICAPS on an AWS-hosted .NET
          microservices architecture. I&rsquo;ve always cared about reliability engineering: in both roles I was
          directly involved in fixing anything a release broke, sometimes in the middle of the night.
        </p>
        <div class="flex flex-wrap gap-3 text-sm">
          <a href="/projects" class="rounded-full border border-base-200 dark:border-base-800 px-4 py-2 hover:border-accent/60">View projects</a>
          <a href="/contact" class="rounded-full border border-base-200 dark:border-base-800 px-4 py-2 hover:border-accent/60">Get in touch</a>
        </div>
      </div>
      <div class="surface p-6 space-y-4">
        <h2 class="text-lg font-semibold text-base-950 dark:text-base-50">Now</h2>
        <ul class="space-y-3 text-sm text-base-600 dark:text-base-300">
          <li>Building EmberTales — an AI reading companion for children, live in production at app.embertales.ai.</li>
          <li>Open source: voicebox, an MCP server that lets a coding agent voice-test browser-based voice agents.</li>
          <li>Selected for the inaugural Women in AI Accelerator (Build Club × v0 by Vercel, 2026).</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section-block">
    <SectionHeading title="Selected projects" subtitle="Two recent builds — real-time voice AI, shipped end to end." />
    <div class="mt-8 grid gap-6 md:grid-cols-2">
      {projects.map((project) => (
        <ProjectCard project={project} />
      ))}
    </div>
    <div class="mt-6">
      <a href="/projects" class="text-sm font-medium hover:text-accent">View all projects →</a>
    </div>
  </section>

  <section class="section-block">
    <SectionHeading title="Writing" subtitle="Notes on voice AI, LLM systems, and production trade-offs." />
    <div class="mt-8 grid gap-6 md:grid-cols-3">
      {posts.map((post) => (
        <BlogCard post={post} />
      ))}
    </div>
    <div class="mt-6">
      <a href="/blog" class="text-sm font-medium hover:text-accent">All posts →</a>
    </div>
  </section>
</SiteLayout>
