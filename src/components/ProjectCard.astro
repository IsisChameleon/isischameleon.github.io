---
import TagPill from './TagPill.astro';

const { project } = Astro.props;
const { data } = project;

// The card's destination: the write-up if one exists, else the live app, else the
// talk, else the source.
const primaryHref = data.blog
  ? `/blog/${data.blog}`
  : data.links?.demo ?? data.links?.talk ?? data.links?.github;
---
<article class="surface relative p-6 flex flex-col gap-4 transition-colors hover:border-accent/60">
  <div>
    <h3 class="text-xl font-semibold text-base-950 dark:text-base-50">
      {primaryHref ? (
        <!-- Stretched link: the whole card is clickable via the ::after overlay,
             while keeping a single semantic anchor on the title. -->
        <a href={primaryHref} class="hover:text-accent after:absolute after:inset-0 after:content-['']">
          {data.title}
        </a>
      ) : data.title}
    </h3>
    <p class="mt-2 text-sm text-base-600 dark:text-base-300">{data.summary}</p>
  </div>
  <div class="flex flex-wrap gap-2">
    {data.tags.map((tag) => (
      <TagPill label={tag} />
    ))}
  </div>
  {data.blog || data.links ? (
    <!-- Relative so these sit above the stretched-link overlay and stay individually clickable. -->
    <div class="relative flex flex-wrap gap-4 text-sm">
      {data.blog ? (
        <a href={`/blog/${data.blog}`} class="hover:text-accent">Read the write-up →</a>
      ) : null}
      {data.links?.github ? (
        <a href={data.links.github} class="hover:text-accent">GitHub →</a>
      ) : null}
      {data.links?.demo ? (
        <a href={data.links.demo} class="hover:text-accent">Live demo →</a>
      ) : null}
      {data.links?.talk ? (
        <a href={data.links.talk} class="hover:text-accent">Watch the talk →</a>
      ) : null}
    </div>
  ) : null}
</article>
